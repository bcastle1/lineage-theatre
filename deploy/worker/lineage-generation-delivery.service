[Unit]
Description=Lineage Theatre paid generation video verification
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/lineage-generation-delivery/host.conf
ExecStartPre=/usr/bin/test -s /etc/lineage-generation-delivery/runtime.env
ExecStart=/usr/bin/docker run --rm --init --name lineage-generation-delivery --label app=lineage-generation-delivery --read-only --user 1000:1000 --cap-drop ALL --security-opt no-new-privileges --cpus 2 --memory 3g --memory-swap 3g --pids-limit 256 --tmpfs /tmp:rw,noexec,nosuid,nodev,size=1g,mode=1777 --env-file /etc/lineage-generation-delivery/runtime.env --entrypoint node ${LINEAGE_DELIVERY_IMAGE} scripts/paid-film-delivery-worker.mjs --once
# The container removes itself after a normal pass. Also clean up interrupted starts.
ExecStopPost=-/usr/bin/docker stop --timeout 120 lineage-generation-delivery
TimeoutStartSec=2h
TimeoutStopSec=150s
StandardOutput=journal
StandardError=journal
UMask=0077
