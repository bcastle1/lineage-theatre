{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/production-worker.mjs": { "maxDuration": 180 },
    "api/fal-review.mjs": { "maxDuration": 300 },
    "api/patrick-quickbooks.mjs": { "maxDuration": 60 },
    "api/film-delivery.mjs": { "maxDuration": 300 },
    "api/media.mjs": { "maxDuration": 300 },
    "api/auth.mjs": {
      "maxDuration": 30
    },
    "api/studio.mjs": {
      "maxDuration": 180
    },
    "api/document.mjs": {
      "maxDuration": 30
    },
    "api/admin.mjs": {
      "maxDuration": 180
    },
    "api/archive.mjs": {
      "maxDuration": 300
    },
    "api/quickbooks.mjs": {
      "maxDuration": 60
    },
    "api/payment-reconcile.mjs": {
      "maxDuration": 180
    },
    "api/film-generation.mjs": {
      "maxDuration": 180
    }
  },
  "crons": [{ "path": "/api/payment-reconcile", "schedule": "* * * * *" },
    { "path": "/api/film-generation", "schedule": "* * * * *" },
    { "path": "/api/film-delivery", "schedule": "* * * * *" },
    { "path": "/api/patrick-quickbooks", "schedule": "17 8 * * *" }]
}
